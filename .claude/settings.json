{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/security-md-reminder.sh\"",
            "timeout": 10,
            "statusMessage": "Checking SECURITY.md scope"
          }
        ]
      }
    ]
  }
}

{
  "name": "nvhash-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "nvHASH Program Console - chain-truth verification tool for the nvHASH liquid staking program",
  "scripts": {
    "dev": "vite --mode devnet",
    "dev:test": "vite --mode test",
    "build": "tsc -b && vite build --mode production",
    "build:test": "tsc -b && vite build --mode test",
    "build:devnet": "tsc -b && vite build --mode devnet",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.8",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.1.4",
    "typescript": "~5.9.3",
    "vite": "^7.3.4",
    "vitest": "^4.0.18"
  }
}

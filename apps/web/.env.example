# nvHASH web app — per-environment configuration (app-spec §7).
# Placeholders only (SECURITY.md): real values come from the environment;
# `.env` files are gitignored. Copy to `.env` for local development.

# ── Client-safe subset ────────────────────────────────────────────────────
# Serialized into the root loader and public by construction. This list must
# match CLIENT_SAFE_CONFIG_KEYS (app/config/client.ts); the bundle-secret
# gate and test/client-config.test.ts enforce the boundary.
APP_ENV=development
CHAIN_ID=chain-dev
CONTRACT_ADDRESS=tp1replace-with-contract-address
VAULT_ADDRESS=tp1replace-with-vault-address
# The console dev server pins port 5273 (apps/console/vite.config.ts).
CONSOLE_URL=http://localhost:5273
# WalletConnect v2 project id (PR 5.1) — client-safe by design: it rides in
# every pairing URI the user's wallet scans (§7 allowlist amendment). Absent,
# the WC transport is disabled; the injected Figure extension still works.
WALLETCONNECT_PROJECT_ID=replace-with-walletconnect-project-id
# Block-explorer base URL for Portfolio transaction verify-links (M6.1):
# public by construction (§7 allowlist amendment). Optional: absent, history
# rows render without a verify-link. Example: https://explorer.provenance.io
EXPLORER_URL=https://explorer.provenance.io

# ── Server-only ───────────────────────────────────────────────────────────
# Never serialized to the client; the bundle-secret gate builds with sentinel
# values for every key here and fails if any reaches build/client.
# LCD endpoint for server-side live reads (ADR-002 dev network: dev-node).
LCD_URL=http://dev-node:1317
# Chain id the configured console profile serves; must equal CHAIN_ID or the
# app refuses to boot (verify links never cross environments, app-spec §12.2).
CONSOLE_CHAIN_ID=chain-dev
# services/api base URL for indexed-plane reads (freshness footer, degraded
# banner). The browser never calls the API directly; reads go through this
# server's loaders (PR 4.1).
API_URL=http://localhost:8787
# PostgreSQL for the `app` schema, connecting as `app_writer` (ADR-001
# Decision 1; PR 5.1). Optional: absent, sessions run on a non-durable
# in-memory store (dev/mock posture). Dev database: `./dev pg up`, port 5433.
DATABASE_URL=postgresql://app_writer:app-dev@localhost:5433/nvhash?schema=app
# HMAC key minting the scoped service assertions services/api verifies
# (ADR-001 Decision 2; PR 5.1). Must match the API's key; ≥ 32 chars.
API_SERVICE_ASSERTION_KEY=replace-with-a-random-key-of-32-plus-chars

# ── Notifier worker (M6.2; `pnpm notifier`) ──────────────────────────────
# A SEPARATE process from the web server (ADR-001 Decision 3). It REQUIRES
# DATABASE_URL (its store) and API_SERVICE_ASSERTION_KEY (to mint the
# `internal:notifier` scope) above — a boot misconfig is a loud exit. It reads
# indexed facts only through services/api under that scope; it holds no
# `indexed` credential. API_BASE_URL defaults to API_URL when unset.
#API_BASE_URL=http://localhost:8787
# Tick cadence (default 60; bounded 10–600) and fact page size (default 200,
# ≤ 500 = the API's MAX_ALERT_FACT_LIMIT).
#NOTIFIER_TICK_SECONDS=60
#NOTIFIER_FACT_LIMIT=200

# ── Tooling toggles (not configuration) ──────────────────────────────────
# NVHASH_MOCK=1 serves chain reads from @nvhash/fixtures via MSW (tests/e2e).
#NVHASH_MOCK=0

# ── Web Push (M6.3; `pnpm notifier` fan-out + per-browser opt-in) ─────────
# VAPID credentials for the Web Push channel (app-spec §10.4, §14.7). ALL-OR-
# NONE: set all three or none — a partial config is a boot error. Left unset
# here so the devnet default is the honest "not configured" state (no
# subscribe path exists). Generate a pair with `npx web-push generate-vapid-keys`.
#   * WEB_PUSH_VAPID_PUBLIC_KEY  — CLIENT-SAFE: public by construction (it ships
#     in pushManager.subscribe). Amended into the §7 client-safe allowlist.
#   * WEB_PUSH_VAPID_PRIVATE_KEY — SERVER-ONLY: the signing key, never bundled.
#   * WEB_PUSH_VAPID_SUBJECT     — SERVER-ONLY: a `mailto:` or https contact
#     (the VAPID `sub` claim), e.g. mailto:ops@example.com.
#WEB_PUSH_VAPID_PUBLIC_KEY=replace-with-vapid-public-key
#WEB_PUSH_VAPID_PRIVATE_KEY=replace-with-vapid-private-key
#WEB_PUSH_VAPID_SUBJECT=mailto:ops@example.com

# (SESSION_SECRET was retired in PR 5.1: the session cookie carries an opaque
# random id resolved against a server-side row — nothing to sign.)

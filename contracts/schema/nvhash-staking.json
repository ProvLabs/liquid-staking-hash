{
  "contract_name": "nvhash-staking",
  "contract_version": "0.1.1",
  "idl_version": "1.0.0",
  "instantiate": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "InstantiateMsg",
    "type": "object",
    "required": [
      "admin",
      "receipt_denom",
      "underlying_denom",
      "vault_address"
    ],
    "properties": {
      "admin": {
        "type": "string"
      },
      "aum_fee_bps": {
        "default": 0,
        "type": "integer",
        "format": "uint64",
        "minimum": 0.0
      },
      "commission_bps": {
        "description": "Program commission rate in bps of rewards on program delegations. None = 10% default.",
        "type": [
          "integer",
          "null"
        ],
        "format": "uint64",
        "minimum": 0.0
      },
      "concentration_safety_offset_bps": {
        "type": [
          "integer",
          "null"
        ],
        "format": "uint64",
        "minimum": 0.0
      },
      "jail_unbond_delay_secs": {
        "description": "Cooldown between jail report and purge. None = 8h default.",
        "type": [
          "integer",
          "null"
        ],
        "format": "uint64",
        "minimum": 0.0
      },
      "max_bonded_cap_bps": {
        "type": [
          "integer",
          "null"
        ],
        "format": "uint64",
        "minimum": 0.0
      },
      "max_concentration_multiple_bps": {
        "description": "Concentration-cap mirrors; None = Provenance defaults (5.5x, 5%, 33%, 5% safety offset).",
        "type": [
          "integer",
          "null"
        ],
        "format": "uint64",
        "minimum": 0.0
      },
      "max_delegations_per_run": {
        "default": 0,
        "type": "integer",
        "format": "uint32",
        "minimum": 0.0
      },
      "min_bonded_cap_bps": {
        "type": [
          "integer",
          "null"
        ],
        "format": "uint64",
        "minimum": 0.0
      },
      "min_capture_interval_secs": {
        "description": "Min seconds between accepted uptime captures (0 = every call accepted).",
        "default": 0,
        "type": "integer",
        "format": "uint64",
        "minimum": 0.0
      },
      "performance_threshold_bps": {
        "description": "Uptime eligibility threshold in bps (0 = uptime gating disabled).",
        "default": 0,
        "type": "integer",
        "format": "uint64",
        "minimum": 0.0
      },
      "receipt_denom": {
        "type": "string"
      },
      "redemption_margin_bps": {
        "description": "Safety margin over the pending-redemption need in bps, bounded 0..=1000. None = 50.",
        "type": [
          "integer",
          "null"
        ],
        "format": "uint64",
        "minimum": 0.0
      },
      "underlying_denom": {
        "type": "string"
      },
      "vault_address": {
        "type": "string"
      }
    },
    "additionalProperties": false
  },
  "execute": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "ExecuteMsg",
    "oneOf": [
      {
        "description": "Admin-gated: pause the managed vault (manual override / emergency stop).",
        "type": "object",
        "required": [
          "pause_vault"
        ],
        "properties": {
          "pause_vault": {
            "type": "object",
            "required": [
              "reason"
            ],
            "properties": {
              "reason": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "description": "Admin-gated: unpause the managed vault.",
        "type": "object",
        "required": [
          "unpause_vault"
        ],
        "properties": {
          "unpause_vault": {
            "type": "object",
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "description": "Admin-gated: update program configuration. Only supplied fields change.",
        "type": "object",
        "required": [
          "update_config"
        ],
        "properties": {
          "update_config": {
            "type": "object",
            "properties": {
              "aum_fee_bps": {
                "type": [
                  "integer",
                  "null"
                ],
                "format": "uint64",
                "minimum": 0.0
              },
              "commission_bps": {
                "type": [
                  "integer",
                  "null"
                ],
                "format": "uint64",
                "minimum": 0.0
              },
              "concentration_safety_offset_bps": {
                "type": [
                  "integer",
                  "null"
                ],
                "format": "uint64",
                "minimum": 0.0
              },
              "jail_unbond_delay_secs": {
                "type": [
                  "integer",
                  "null"
                ],
                "format": "uint64",
                "minimum": 0.0
              },
              "max_bonded_cap_bps": {
                "type": [
                  "integer",
                  "null"
                ],
                "format": "uint64",
                "minimum": 0.0
              },
              "max_concentration_multiple_bps": {
                "type": [
                  "integer",
                  "null"
                ],
                "format": "uint64",
                "minimum": 0.0
              },
              "max_delegations_per_run": {
                "type": [
                  "integer",
                  "null"
                ],
                "format": "uint32",
                "minimum": 0.0
              },
              "min_bonded_cap_bps": {
                "type": [
                  "integer",
                  "null"
                ],
                "format": "uint64",
                "minimum": 0.0
              },
              "min_capture_interval_secs": {
                "type": [
                  "integer",
                  "null"
                ],
                "format": "uint64",
                "minimum": 0.0
              },
              "performance_threshold_bps": {
                "type": [
                  "integer",
                  "null"
                ],
                "format": "uint64",
                "minimum": 0.0
              },
              "redemption_margin_bps": {
                "type": [
                  "integer",
                  "null"
                ],
                "format": "uint64",
                "minimum": 0.0
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "description": "Admin-gated: emergency stop/resume for the fund-moving permissionless cranks (RunEpoch, ServiceRedemptions). Does not touch the vault's own pause state.",
        "type": "object",
        "required": [
          "set_halted"
        ],
        "properties": {
          "set_halted": {
            "type": "object",
            "required": [
              "halted"
            ],
            "properties": {
              "halted": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "description": "Admin-gated: abort a stuck epoch continuation by dropping the persisted delegation targets; the withdrawn nhash settles at the next epoch, so TVV is preserved.",
        "type": "object",
        "required": [
          "clear_pending_delegations"
        ],
        "properties": {
          "clear_pending_delegations": {
            "type": "object",
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "description": "Enroll a validator in the program; the caller must be the valoper's operator account and the validator must exist on chain.",
        "type": "object",
        "required": [
          "register_participation"
        ],
        "properties": {
          "register_participation": {
            "type": "object",
            "required": [
              "valoper"
            ],
            "properties": {
              "valoper": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "description": "Operator or admin: withdraw a validator; its program stake is unbonded at the next epoch and redeployed.",
        "type": "object",
        "required": [
          "unregister_participation"
        ],
        "properties": {
          "unregister_participation": {
            "type": "object",
            "required": [
              "valoper"
            ],
            "properties": {
              "valoper": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "description": "Permissionless: report a jailed validator, starting the jail_unbond_delay cooldown; a report on an unjailed validator clears instead. Moves no funds.",
        "type": "object",
        "required": [
          "report_jailed_validator"
        ],
        "properties": {
          "report_jailed_validator": {
            "type": "object",
            "required": [
              "valoper"
            ],
            "properties": {
              "valoper": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "description": "Permissionless (halt-gated): after the cooldown, move stake off a still-jailed validator (redelegate to an eligible claimant's headroom, else unbond all).",
        "type": "object",
        "required": [
          "purge_jailed_validator"
        ],
        "properties": {
          "purge_jailed_validator": {
            "type": "object",
            "required": [
              "valoper"
            ],
            "properties": {
              "claimant_valoper": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "valoper": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "description": "Anyone (nhash attached): pay program commission for an enrolled validator. Non-refundable; overpayment prepays future accrual; swept into vault principal next epoch.",
        "type": "object",
        "required": [
          "pay_commission"
        ],
        "properties": {
          "pay_commission": {
            "type": "object",
            "required": [
              "valoper"
            ],
            "properties": {
              "valoper": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "description": "Anyone (nhash attached): pay a tip for an enrolled validator. Credits the current epoch's tip (the primary priority key, reset each epoch); non-refundable.",
        "type": "object",
        "required": [
          "pay_tip"
        ],
        "properties": {
          "pay_tip": {
            "type": "object",
            "required": [
              "valoper"
            ],
            "properties": {
              "valoper": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "description": "Permissionless: fold each enrolled validator's signed-blocks ratio into its per-epoch uptime accumulator. Interval-gated; early calls are accepted no-ops.",
        "type": "object",
        "required": [
          "capture_uptime_signal"
        ],
        "properties": {
          "capture_uptime_signal": {
            "type": "object",
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "description": "Permissionless: withdraw accrued staking rewards for every delegated validator. Call in a tx before RunEpoch so the current epoch's deposit includes them.",
        "type": "object",
        "required": [
          "claim_rewards"
        ],
        "properties": {
          "claim_rewards": {
            "type": "object",
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "description": "Permissionless (halt-gated): unbond to cover queued swap-outs and expedite funded ones; expedites are gated on principal-marker liquidity only.",
        "type": "object",
        "required": [
          "service_redemptions"
        ],
        "properties": {
          "service_redemptions": {
            "type": "object",
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "description": "Permissionless (min-interval and halt guarded): the full epoch crank. Bypasses the interval guard only to drain a pending continuation.",
        "type": "object",
        "required": [
          "run_epoch"
        ],
        "properties": {
          "run_epoch": {
            "type": "object",
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    ]
  },
  "query": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "QueryMsg",
    "oneOf": [
      {
        "type": "object",
        "required": [
          "config"
        ],
        "properties": {
          "config": {
            "type": "object",
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "type": "object",
        "required": [
          "epoch_status"
        ],
        "properties": {
          "epoch_status": {
            "type": "object",
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "description": "Enrolled validators with live eligibility read from current chain state, sorted by program priority (tip desc, uptime desc, enrollment age), highest first.",
        "type": "object",
        "required": [
          "validators"
        ],
        "properties": {
          "validators": {
            "type": "object",
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "description": "Open jail reports: validators observed jailed and the time a purge becomes allowed.",
        "type": "object",
        "required": [
          "jail_reports"
        ],
        "properties": {
          "jail_reports": {
            "type": "object",
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "description": "The most recent epoch's value decomposition; None before the first epoch crank.",
        "type": "object",
        "required": [
          "epoch_snapshot"
        ],
        "properties": {
          "epoch_snapshot": {
            "type": "object",
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "description": "Realized APR over the last epoch window with the gross-to-net breakdown. None before the first epoch crank.",
        "type": "object",
        "required": [
          "apr"
        ],
        "properties": {
          "apr": {
            "type": "object",
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "description": "The receipt-conservation invariant's legs in one consistent state read. Read-only, permissionless, bounded by the validator ceiling.",
        "type": "object",
        "required": [
          "receipt_accounting"
        ],
        "properties": {
          "receipt_accounting": {
            "type": "object",
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    ]
  },
  "migrate": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "MigrateMsg",
    "description": "Empty migration message; migration only re-stamps the cw2 version record.",
    "type": "object",
    "additionalProperties": false
  },
  "sudo": null,
  "responses": {
    "apr": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "AprResponse",
      "type": "object",
      "required": [
        "aum_fee_estimate",
        "commission_received",
        "epoch_index",
        "gross_apr_bps",
        "net_apr_bps",
        "rewards_claimed",
        "tips_received",
        "tvv_before",
        "window_seconds",
        "write_down"
      ],
      "properties": {
        "aum_fee_estimate": {
          "description": "Window drags: the AUM estimate and slash losses recognized this epoch.",
          "allOf": [
            {
              "$ref": "#/definitions/Uint128"
            }
          ]
        },
        "commission_received": {
          "$ref": "#/definitions/Uint128"
        },
        "epoch_index": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "gross_apr_bps": {
          "description": "(rewards + commission + tips) annualized against tvv_before, in bps.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "net_apr_bps": {
          "description": "Gross inflow minus drags (floored at zero) annualized, in bps.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "rewards_claimed": {
          "description": "Window inflow components.",
          "allOf": [
            {
              "$ref": "#/definitions/Uint128"
            }
          ]
        },
        "tips_received": {
          "$ref": "#/definitions/Uint128"
        },
        "tvv_before": {
          "$ref": "#/definitions/Uint128"
        },
        "window_seconds": {
          "description": "Seconds between the previous and last snapshot (the measurement window).",
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "write_down": {
          "$ref": "#/definitions/Uint128"
        }
      },
      "additionalProperties": false,
      "definitions": {
        "Uint128": {
          "description": "A thin wrapper around u128 that is using strings for JSON encoding/decoding, such that the full u128 range can be used for clients that convert JSON numbers to floats, like JavaScript and jq.\n\n# Examples\n\nUse `from` to create instances of this and `u128` to get the value out:\n\n``` # use cosmwasm_std::Uint128; let a = Uint128::from(123u128); assert_eq!(a.u128(), 123);\n\nlet b = Uint128::from(42u64); assert_eq!(b.u128(), 42);\n\nlet c = Uint128::from(70u32); assert_eq!(c.u128(), 70); ```",
          "type": "string"
        }
      }
    },
    "config": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "ConfigResponse",
      "type": "object",
      "required": [
        "admin",
        "aum_fee_bps",
        "commission_bps",
        "concentration_safety_offset_bps",
        "jail_unbond_delay_secs",
        "max_bonded_cap_bps",
        "max_concentration_multiple_bps",
        "max_delegations_per_run",
        "min_bonded_cap_bps",
        "min_capture_interval_secs",
        "performance_threshold_bps",
        "receipt_denom",
        "redemption_margin_bps",
        "underlying_denom",
        "vault_address"
      ],
      "properties": {
        "admin": {
          "type": "string"
        },
        "aum_fee_bps": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "commission_bps": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "concentration_safety_offset_bps": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "jail_unbond_delay_secs": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "max_bonded_cap_bps": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "max_concentration_multiple_bps": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "max_delegations_per_run": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "min_bonded_cap_bps": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "min_capture_interval_secs": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "performance_threshold_bps": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "receipt_denom": {
          "type": "string"
        },
        "redemption_margin_bps": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "underlying_denom": {
          "type": "string"
        },
        "vault_address": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "epoch_snapshot": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "EpochSnapshotResponse",
      "type": "object",
      "properties": {
        "snapshot": {
          "anyOf": [
            {
              "$ref": "#/definitions/EpochSnapshot"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "definitions": {
        "EpochSnapshot": {
          "description": "The single most recent epoch value decomposition: overwritten every epoch, never a history. `tvv_after = tvv_before + rewards_deposited - write_down` by construction; its `tvv_after` seeds the next epoch's `net_deposits`.",
          "type": "object",
          "required": [
            "aum_fee_estimate",
            "commission_received",
            "deployed",
            "eligible_count",
            "end_height",
            "ended_at_seconds",
            "epoch_index",
            "net_deposits",
            "redemptions_expedited",
            "rewards_claimed",
            "rewards_deposited",
            "settled",
            "started_at_seconds",
            "tips_received",
            "total_shares",
            "tvv_after",
            "tvv_before",
            "unbonded_for_redemptions",
            "validators_purged",
            "write_down"
          ],
          "properties": {
            "aum_fee_estimate": {
              "description": "AUM drag over the window, estimated from the admin's aum_fee_bps mirror.",
              "allOf": [
                {
                  "$ref": "#/definitions/Uint128"
                }
              ]
            },
            "commission_received": {
              "$ref": "#/definitions/Uint128"
            },
            "deployed": {
              "description": "This crank's fresh deployment (receipt minted and delegated).",
              "allOf": [
                {
                  "$ref": "#/definitions/Uint128"
                }
              ]
            },
            "eligible_count": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0.0
            },
            "end_height": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0.0
            },
            "ended_at_seconds": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0.0
            },
            "epoch_index": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0.0
            },
            "net_deposits": {
              "description": "User swap flow since the previous epoch: tvv_before - previous tvv_after (negative = net redemptions).",
              "allOf": [
                {
                  "$ref": "#/definitions/Int128"
                }
              ]
            },
            "rebalanced": {
              "description": "Stake redirected by the uniform-slot rebalance; value-neutral.",
              "default": "0",
              "allOf": [
                {
                  "$ref": "#/definitions/Uint128"
                }
              ]
            },
            "redemptions_expedited": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0.0
            },
            "rewards_claimed": {
              "description": "Window inflows (accumulated since the previous snapshot, incl. this crank).",
              "allOf": [
                {
                  "$ref": "#/definitions/Uint128"
                }
              ]
            },
            "rewards_deposited": {
              "description": "This crank's actual NAV step (liquid swept into principal).",
              "allOf": [
                {
                  "$ref": "#/definitions/Uint128"
                }
              ]
            },
            "settled": {
              "description": "This crank's value-neutral return settlement and slash recognition.",
              "allOf": [
                {
                  "$ref": "#/definitions/Uint128"
                }
              ]
            },
            "started_at_seconds": {
              "description": "Previous snapshot's end (0 for the first epoch: derived rates guard on it).",
              "type": "integer",
              "format": "uint64",
              "minimum": 0.0
            },
            "tips_received": {
              "$ref": "#/definitions/Uint128"
            },
            "total_shares": {
              "$ref": "#/definitions/Uint128"
            },
            "tvv_after": {
              "description": "Expected post-crank TVV: before + rewards_deposited - write_down.",
              "allOf": [
                {
                  "$ref": "#/definitions/Uint128"
                }
              ]
            },
            "tvv_before": {
              "$ref": "#/definitions/Uint128"
            },
            "unbonded_for_redemptions": {
              "$ref": "#/definitions/Uint128"

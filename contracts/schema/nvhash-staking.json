                }
              ]
            },
            "commission_due": {
              "$ref": "#/definitions/Uint128"
            },
            "commission_paid": {
              "$ref": "#/definitions/Uint128"
            },
            "eligible": {
              "description": "Live eligibility: enrolled, bonded, not jailed/tombstoned, uptime meets the configured threshold, commission current.",
              "type": "boolean"
            },
            "enrolled_at_seconds": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0.0
            },
            "headroom": {
              "description": "nhash of new delegation this validator could still legally receive under the concentration cap minus the safety offset (0 when ineligible).",
              "allOf": [
                {
                  "$ref": "#/definitions/Uint128"
                }
              ]

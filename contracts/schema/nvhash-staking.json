                {
                  "$ref": "#/definitions/Uint128"
                }
              ]
            },
            "tombstoned": {
              "type": "boolean"
            },
            "uptime_bps": {
              "description": "Effective uptime in bps (accumulator mean if any captures, else the live signing-info read). None when uptime cannot be determined (validator or signing info missing, non-ed25519 consensus key).",

# services/api environment (placeholders only — SECURITY.md: never commit real
# credentials; .env is gitignored). Copy to .env for local use. Every value is
# validated and bounded at the boundary (src/config.ts); an out-of-range value
# fails startup rather than being clamped silently.

# App environment — drives the environment badge (app-spec §7).
#   development | staging | production
APP_ENV="development"

# TCP port the read-only API listens on.
PORT="8080"

# Rate limiting (SECURITY.md: APIs are read-only and defensive, rate-limited).
# RATE_LIMIT_MAX requests per RATE_LIMIT_WINDOW_MS per client.
RATE_LIMIT_MAX="120"
RATE_LIMIT_WINDOW_MS="60000"

# Trust a front proxy's X-Forwarded-For for the rate-limit client key. Leave
# "false" unless behind a proxy that OVERWRITES the header — otherwise a client
# could spoof its key.
TRUST_PROXY="false"

# SELECT-only `api_reader` connection over the `indexed` schema (ADR-001
# Decision 1), consumed since PR 3.1. OPTIONAL: leave unset to run dataless —
# every route then reports the honest empty/null state ("unwired").
# DATABASE_URL="postgresql://api_reader:api-dev@postgres:5432/nvhash?schema=indexed"

# HMAC key verifying the web tier's short-lived address-scoped assertions
# (ADR-001 Decision 2 + its wire-format amendment), consumed since PR 3.3.
# OPTIONAL but fail-closed: unset, every address-scoped request answers 401.
# ≥32 characters (bounded at config). Server-only; never in a client bundle.
# API_SERVICE_ASSERTION_KEY="change-me-to-a-long-random-secret-value"

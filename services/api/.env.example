# services/api environment (placeholders only — SECURITY.md: never commit real
# credentials; .env is gitignored). Copy to .env for local use. Every value is
# validated and bounded at the boundary (src/config.ts); an out-of-range value
# fails startup rather than being clamped silently.

# App environment — drives the environment badge (app-spec §7).
#   development | staging | production
APP_ENV="development"

# TCP port the read-only API listens on.
PORT="8080"

# Rate limiting (SECURITY.md: APIs are read-only and defensive, rate-limited).
# RATE_LIMIT_MAX requests per RATE_LIMIT_WINDOW_MS per client.
RATE_LIMIT_MAX="120"
RATE_LIMIT_WINDOW_MS="60000"

# Trust a front proxy's X-Forwarded-For for the rate-limit client key. Leave
# "false" unless behind a proxy that OVERWRITES the header — otherwise a client
# could spoof its key.
TRUST_PROXY="false"

# --- Not consumed by the M1 scaffold; placeholders for later PRs ------------
# The scaffold performs no indexed reads and exposes no address-scoped route,
# so these are documented here (secrets via env only) but read by later PRs:
#
#   DATABASE_URL — SELECT-only `api_reader` role over the `indexed` schema
#     (ADR-001 Decision 1). Wired when data endpoints land (PR 3.1). Example:
#     postgresql://api_reader:PASSWORD@postgres:5432/nvhash?schema=indexed
#
#   API_SERVICE_ASSERTION_KEY — HMAC key verifying the web tier's short-lived
#     address-scoped assertions (ADR-001 Decision 2). Consumed by the
#     address-scoped endpoints in PR 3.3. Server-only; never in a client bundle.

# services/indexer environment (placeholders only — SECURITY.md: never commit
# real credentials; .env is gitignored). Copy to .env for local use.

# PostgreSQL. In real environments this resolves to the indexer's own role
# credential (`indexer_writer`, ADR-001 Decision 1). For local `./dev` work the
# tools container reaches the dev database by compose service name:
#   postgresql://nvhash:nvhash-dev@postgres:5432/nvhash?schema=indexed
# (host tooling would use localhost:5433 — but JS tasks run in the container).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=indexed"

# Provenance LCD base for chain reads. Reachable in the dev network as:
#   http://dev-node:1317
LCD_URL="http://dev-node:1317"

# Tendermint RPC base (block_results/tx_search — EndBlocker payout/refund/NAV
# and height-range tx lookup). Reachable in the dev network as:
#   http://dev-node:26657
RPC_URL="http://dev-node:26657"

# Chain / contract identity (public config).
CHAIN_ID="chain-dev"
CONTRACT_ADDRESS="tp1..."
VAULT_ADDRESS="tp1..."

# Vault share (receipt) denom — scopes NAV markers to this program.
RECEIPT_DENOM="nvhash"

# Worker tuning (optional; shown with defaults). CONFIRMATION_DEPTH=0 is safe on
# Provenance (instant finality); INDEX_WINDOW_SPAN bounds heights per window
# transaction; POLL_INTERVAL_MS is the caught-up poll delay.
# CONFIRMATION_DEPTH="0"
# INDEX_WINDOW_SPAN="500"
# POLL_INTERVAL_MS="5000"
# Reconciler pass cadence (the honesty alarm; slower than the workers, §12.1).
# RECONCILE_INTERVAL_MS="30000"

# Governance stream (PR 7.1). Both optional.
#
# GOV_GROUP_POLICIES adds x/group policy addresses to mirror ON TOP of what
# discovery finds (Config.admin -> policy -> group -> every policy on that
# group). It never replaces discovery, so it cannot be used to pin the indexer to
# one policy and miss the pending admin/ops split. Its real use is a chain whose
# contract was instantiated BEFORE its group existed: the contract has no
# admin-rotation message, so discovery correctly resolves to the empty set there
# and the policies have to be named. Comma-separated bech32; a malformed entry is
# a boot error, not a silent skip (a typo would otherwise look like honest-empty).
# GOV_GROUP_POLICIES=""
# First height the governance stream ingests (D13: 1, like the other streams;
# `indexed_from_height` on the list payload keeps the page honest about the window).
# GOV_START_HEIGHT="1"
# First height the CHAIN workers (chain-events, epoch-history,
# validator-sampler) ingest; default 1 (devnet-compatible). Per environment:
# the contract STORE height recorded by the testnet bootstrap (plan 8.4 §2.9)
# — history before the contract exists is empty by construction, and a
# public-testnet backfill from 1 walks millions of pre-contract blocks with
# the DATA DEGRADED banner up for weeks. Bounded integer >= 1; never clamp.
# INDEX_START_HEIGHT="1"

// nvHASH indexer — Prisma multi-file schema (app-spec §5.3, §9.1).
//
// One model per `prisma/*.prisma` file (the nuva precedent). Every table
// lives in the `indexed` Postgres schema, owned by the `indexer_writer` role
// (ADR-001 Decision 1) — the sole writer of indexed data, which is fully
// rebuildable from chain. `services/api` reads it through a SELECT-only role.
//
// Amount discipline (app-spec §5.8): base-unit amounts are `Decimal @db.Decimal(39,0)`
// — never a JS number, never floating point, anywhere in the indexer.
//
// Data minimization (SECURITY.md, app-spec §9.1): the `indexed` schema holds
// only public chain data plus operational cursors. No user-identifiable
// information, no IP/device identifiers — enforced, not trusted, by the
// schema-field allowlist gate (test/schema-allowlist.test.ts). Adding a column
// is a design-review event: it must be added to the allowlist, not merely to a
// migration.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["indexed"]
}

// Explicit output, gitignored: `apps/web` is the repo's SOLE default-output
// generator, so nothing else may write the hoisted node_modules/@prisma/client
// (two writers make the last `prisma generate` in a process tree win,
// globally). Every generator in this schema declares an explicit path —
// asserted by test/prisma-generator-output.test.ts. The path is OUTSIDE this
// directory because the whole `prisma/` dir is the multi-file schema: a client
// generated into it would be re-read as schema source on the next generate.
// Import the client via src/prisma.ts, never from a generated path directly.
generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

// The read-only client for `services/api` (@nvhash/db-indexed
// 3.1). Generated FROM this canonical schema — the package holds no schema
// copy, so the two clients cannot drift (ADR-001 Decision 1: this service
// owns the schema; the API consumes a generated view of it). Read-only is
// enforced by the `api_reader` ROLE (roles.sql + the grant-boundary gate),
// not by the client. Output path is relative to this file.
generator dbIndexed {
  provider = "prisma-client-js"
  output   = "../../../packages/db-indexed/generated/client"
}
